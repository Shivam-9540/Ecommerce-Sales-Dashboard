      <aliases enabled='yes' />
      <column caption='YOY Sales Margin' datatype='string' name='[Calculation_0705116137590784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1003633215926277]&gt;0 THEN &apos;▲&apos; ELSEIF [Calculation_1003633215926277]&lt;0 THEN &apos;▼&apos; END' />
      </column>
      <column caption='YTD Sales' datatype='real' name='[Calculation_0705116148867085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])= {MAX(YEAR([Order Date])) } THEN [Sales] END' />
      </column>
      <column caption='% Difference' datatype='real' name='[Calculation_0705116153180176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_0705116148867085])-SUM([YTD Sales (copy)_0705116152995855]))/SUM([YTD Sales (copy)_0705116152995855])' />
      </column>
      <column caption='Sales Margin' datatype='string' name='[Calculation_0705116154347537]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_0705116148867085])-SUM([YTD Sales (copy)_0705116152995855])&lt;0 THEN &apos;Less Then PY&apos;&#13;&#10;ELSEIF SUM([Calculation_0705116148867085])-SUM([YTD Sales (copy)_0705116152995855])&gt;0 THEN &apos;Greater Then PY&apos;&#13;&#10;ELSEIF ISNULL(SUM([YTD Sales (copy)_0705116152995855])) THEN &apos;No Sales in PY&apos;&#13;&#10;END' />
      </column>
      <column caption='Positive % Differecne' datatype='string' name='[Calculation_0705116156006418]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0705116153180176]&gt;0 THEN &apos;▲&apos; END' />
      </column>
      <column caption='No Sales' datatype='string' name='[Calculation_0705116157247508]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0705116154347537]=&apos;No Sales in PY&apos; THEN &apos;No Sales in PY&apos; END' />
      </column>
      <column caption='YTD Sales LOD' datatype='real' name='[Calculation_1003633212112897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF YEAR([Order Date])= { MAX(YEAR([Order Date])) } THEN [Sales] END) }' />
      </column>
      <column caption='YOY Sales%' datatype='real' name='[Calculation_1003633215926277]' role='measure' type='quantitative'>
